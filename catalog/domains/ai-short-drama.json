    {
      "id": "DR-01",
      "title": "角色身份、服装与跨镜头一致性",
      "category": "视觉一致性",
      "priority": "P0",
      "maturity": "M2",
      "summary": "同一角色跨镜头面部、服装、体型或情绪漂移",
      "rootCause": "逐镜生成缺少持久身份表征与状态约束",
      "symptoms": [
        "相邻镜头变脸",
        "服装纹理或颜色漂移",
        "人物姿态和情绪突然重置"
      ],
      "solutions": [
        {
          "name": "角色圣经与多视角参考",
          "approach": "为每个人物建立身份、服装版本、正侧背参考图和可追溯 Asset ID。",
          "limitations": "不能完全防止复杂运动后的身份偏移",
          "tools": [
            "Character Bible",
            "Reference Image"
          ]
        },
        {
          "name": "多镜头一致性生成",
          "approach": "在支持参考素材的生成模型上固定角色引用，并用身份相似度与人工审片联合筛选。",
          "limitations": "研究能力与线上服务差异较大",
          "tools": [
            "PersonaShot",
            "EntityBench",
            "PoCo"
          ]
        },
        {
          "name": "失败镜头局部修正",
          "approach": "仅对角色漂移的镜头做 masked edit，更新该镜头版本及相关依赖。",
          "limitations": "遮罩边缘和时序稳定性仍可能不达标",
          "tools": [
            "VACE",
            "Runway Aleph 2.0"
          ]
        }
      ],
